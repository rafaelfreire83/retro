{
  "name": "retro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "firebase emulators:exec --only auth,firestore --project demo-retro \"VITE_USE_EMULATOR=true vite --port 5180 --strictPort\"",
    "build": "vite build",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only firestore --project demo-retro \"node --test test/rules.test.js\"",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "lint": "oxlint"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "firebase": "^12.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^13.35.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
